{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static-site",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),fs=require('fs'),p=require('path');const r=process.cwd();const t={'.html':'text/html','.js':'text/javascript','.css':'text/css','.svg':'image/svg+xml','.png':'image/png','.jpg':'image/jpeg','.jpeg':'image/jpeg','.pdf':'application/pdf','.json':'application/json'};h.createServer((q,s)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const f=p.join(r,u);if(!f.startsWith(r)){s.writeHead(403);s.end();return}fs.readFile(f,(e,d)=>{if(e){s.writeHead(404);s.end('Not found');return}s.writeHead(200,{'Content-Type':t[p.extname(f).toLowerCase()]||'application/octet-stream'});s.end(d)})}).listen(8791,()=>console.log('listening on 8791'))"
      ],
      "port": 8791
    }
  ]
}
